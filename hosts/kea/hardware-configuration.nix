# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "nvme"
    "xhci_pci"
    "thunderbolt"
    "usbhid"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/mapper/KEAROOT";
    fsType = "ext4";
  };

  boot.initrd.luks.devices."KEAROOT".device =
    "/dev/disk/by-uuid/24837784-a0eb-402c-a42e-ed5d6b4747c4";

  fileSystems."/nix/store" = {
    device = "/dev/mapper/KEADATA";
    fsType = "btrfs";
    options = [ "subvol=nix/store" ];
  };

  boot.initrd.luks.devices."KEADATA".device =
    "/dev/disk/by-uuid/e11888f4-c632-43b1-bb40-2bfa7e43c952";

  fileSystems."/data" = {
    device = "/dev/mapper/KEADATA";
    fsType = "btrfs";
  };

  fileSystems."/var/lib/docker" = {
    device = "/dev/mapper/KEADATA";
    fsType = "btrfs";
    options = [ "subvol=var/lib/docker" ];
  };

  fileSystems."/var/lib/libvirt" = {
    device = "/dev/mapper/KEADATA";
    fsType = "btrfs";
    options = [ "subvol=var/lib/libvirt" ];
  };

  fileSystems."/bin" = {
    device = "/usr/bin";
    fsType = "none";
    options = [ "bind" ];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/B18A-93F2";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  fileSystems."/home" = {
    device = "/dev/mapper/KEAHOME";
    fsType = "btrfs";
  };

  boot.initrd.luks.devices."KEAHOME".device =
    "/dev/disk/by-uuid/69528798-19e8-48d5-95b2-140459b4a571";

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  hardware = {
    cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;

    graphics = {
      enable = true;
      enable32Bit = true;
    };
  };
}
