bindsym $cmd+0 workspace number 10
bindsym $cmd+1 workspace number 1
bindsym $cmd+2 workspace number 2
bindsym $cmd+3 workspace number 3
bindsym $cmd+4 workspace number 4
bindsym $cmd+5 workspace number 5
bindsym $cmd+6 workspace number 6
bindsym $cmd+7 workspace number 7
bindsym $cmd+8 workspace number 8
bindsym $cmd+9 workspace number 9
bindsym $cmd+Control+Down move workspace to output down
bindsym $cmd+Control+Left move workspace to output left
bindsym $cmd+Control+Right move workspace to output right
bindsym $cmd+Control+Shift+q exec --no-startup-id "xkill"
bindsym $cmd+Control+Up move workspace to output up
bindsym $cmd+Ctrl+Return exec $term
bindsym $cmd+Ctrl+Shift+Return exec pkexec env XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WAYLAND_DISPLAY=$WAYLAND_DISPLAY $term #Don't use it!
bindsym $cmd+Down focus down
bindsym $cmd+F2 exec gmrun
bindsym $cmd+Left focus left
bindsym $cmd+Return exec $term -e tmux
bindsym $cmd+Shift+Return exec $term  --title="foot (root)" -e sudo -i tmux
bindsym $cmd+Right focus right
bindsym $cmd+Shift+0 move container to workspace number 10
bindsym $cmd+Shift+1 move container to workspace number 1
bindsym $cmd+Shift+2 move container to workspace number 2
bindsym $cmd+Shift+3 move container to workspace number 3
bindsym $cmd+Shift+4 move container to workspace number 4
bindsym $cmd+Shift+5 move container to workspace number 5
bindsym $cmd+Shift+6 move container to workspace number 6
bindsym $cmd+Shift+7 move container to workspace number 7
bindsym $cmd+Shift+8 move container to workspace number 8
bindsym $cmd+Shift+9 move container to workspace number 9
bindsym $cmd+Shift+Down move down
bindsym $cmd+Shift+Left move left
bindsym $cmd+Shift+Right move right
bindsym $cmd+Shift+Tab move workspace back_and_forth
bindsym $cmd+Shift+Up move up
bindsym $cmd+Shift+a exec "~/.config/sway/swaysnipper.sh"
bindsym $cmd+Shift+b focus parent
bindsym $cmd+Shift+c exec i3change_context.sh _
bindsym $cmd+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $cmd+Shift+f floating toggle
bindsym $cmd+Shift+q kill
bindsym $cmd+Shift+r reload
bindsym $cmd+Shift+s exec ~/.config/sway/scripts/toggle-scratchpad.sh
bindsym $cmd+Shift+space floating toggle
bindsym $cmd+Tab workspace back_and_forth
bindsym $cmd+Up focus up
bindsym $cmd+a exec "pwvucontrol"
bindsym $cmd+d workspace ""
bindsym $cmd+e layout toggle split
bindsym $cmd+f fullscreen

bindsym $cmd+l exec "dm-tool lock"
bindsym $cmd+n exec "foot -a yazi -T yazi -e yazi"
bindsym $cmd+p exec "gopass ls --flat | dmenu | xargs --no-run-if-empty gopass show -f | head -n 1 | xdotool type --clearmodifiers --file -"
bindsym $cmd+r mode "resize"
bindsym $cmd+s scratchpad show
bindsym $cmd+v exec clipcat-menu

bindsym XF86MonBrightnessUp exec notify-send -t 1000 -a 'brightness' "$(brightnessctl -m set 20%+|awk -F, '{printf "Bildschirmhelligeit ist jetzt %s", $4}')"
bindsym XF86MonBrightnessDown exec notify-send -t 1000 -a 'brightness' "$(brightnessctl -m set 20%-|awk -F, '{printf "Bildschirmhelligeit ist jetzt %s", $4}')"

bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ && wpvol
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpvol
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && wpctl get-volume @DEFAULT_AUDIO_SINK@|grep -q MUTED && notify-send -t 1000 -a 'wp-vol' "Stumm" || notify-send -t 1000 -a 'wp-vol' "Eingeschaltet"

floating_modifier $cmd normal

mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
