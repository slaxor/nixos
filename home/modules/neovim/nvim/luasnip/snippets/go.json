{
  "init": {
    "prefix": "init",
    "description": "an init() with log settings",
    "body": [
      "func init() {",
      "\tlog.SetFlags(log.Lshortfile)",
      "}"
    ]
  },
  "initc": {
    "prefix": "initc",
    "description": "init vipercfg",
    "body": [
      "func initConfig(env string) error {",
      "\tviper.SetConfigName(fmt.Sprintf(\"%s_%s.conf\", APPNAME, env))",
      "\tviper.SetConfigType(\"toml\")",
      "\tviper.AddConfigPath(\".\")",
      "\tviper.SetEnvPrefix(APPNAME)",
      "\tviper.AutomaticEnv()",
      "\tviper.SetEnvKeyReplacer(strings.NewReplacer(\".\", \"_\"))",
      "\tviper.SetDefault(\"log.level\", \"info\")",
      "\tviper.SetDefault(\"log.output\", \"stderr\")",
      "\tviper.SetDefault(\"${1:key}\", \"${2:val}\")",
      "\treturn viper.ReadInConfig()",
      "}"
    ]
  },
  "errl": {
    "prefix": "errl",
    "description": "error logging",
    "body": [
      "if err != nil {",
      "\tlogger.${1:Error}(err)",
      "}"
    ]
  },
  "errr": {
    "prefix": "errr",
    "description": "error return",
    "body": [
      "if err != nil {",
      "\treturn err",
      "}"
    ]
  },
  "errp": {
    "prefix": "errp",
    "description": "error panic",
    "body": [
      "if err != nil {",
      "\tpanic(err)",
      "}"
    ]
  },
  "testm": {
    "prefix": "testm",
    "description": "test main func",
    "body": [
      "func TestMain(m *testing.M) {",
      "\tcode := m.Run()",
      "\tos.Exit(code)",
      "}"
    ]
  },
  "suite": {
    "prefix": "suite",
    "description": "test suite for github.com/stretchr/testify/suite",
    "body": [
      "func Test${1:Suite}(t *testing.T) {",
      "\tsuite.Run(t, new($1TestSuite))",
      "}",
      "",
      "type $1TestSuite struct {",
      "\tsuite.Suite",
      "\t$1 $1",
      "}",
      "",
      "func (suite *$1TestSuite) SetupTest() {",
      "\tsuite.$1 = $1{}",
      "}",
      "",
      "func (suite *$1TestSuite) Test${2:subject}() {",
      "\tfor _, tc := range []struct {",
      "\t\tname string",
      "\t\tin   $1",
      "\t\texp  []string",
      "\t}{",
      "\t\t{\"zero\", $1{}, []string{}},",
      "\t\t{\"one\", $1{}, []string{\"\"}},",
      "\t\t{\"two\", $1{}, []string{\"¿foo?\"}},",
      "\t\t{\"four\", $1{}, nil},",
      "\t\t{\"xmastree\", $1{}, []string{\"¿foo?\", \"¿bar?\", \"¿baz?\", \"¿gul?\", \"¿bit?\", \"¿lom?\", \"¿tir?\", \"¿lof?\"}},",
      "\t} {",
      "\t\tsuite.Run(tc.name, func() {",
      "\t\t\tact := tc.in.$2()",
      "\t\t\tsuite.Equal(tc.exp, act)",
      "\t\t})",
      "\t}",
      "}"
    ]
  },
  "sfn": {
    "prefix": "sfn",
    "description": "test suite func for github.com/stretchr/testify/suite",
    "body": [
      "func (suite *${1:Suite}TestSuite) Test${2:subject}() {",
      "\tfor _, tc := range []struct {",
      "\t\tname string",
      "\t\tin   $1",
      "\t\texp  []string",
      "\t}{",
      "\t\t{\"zero\", $1{}, []string{}},",
      "\t\t{\"one\", $1{}, []string{\"\"}},",
      "\t\t{\"two\", $1{}, []string{\"¿foo?\"}},",
      "\t\t{\"four\", $1{}, nil},",
      "\t\t{\"xmastree\", $1{}, []string{\"¿foo?\", \"¿bar?\", \"¿baz?\", \"¿gul?\", \"¿bit?\", \"¿lom?\", \"¿tir?\", \"¿lof?\"}},",
      "\t} {",
      "\t\tsuite.Run(tc.name, func() {",
      "\t\t\tact := tc.in.$2()",
      "\t\t\tsuite.Equal(tc.exp, act)",
      "\t\t})",
      "\t}",
      "}"
    ]
  },
  "fn": {
    "prefix": "fn",
    "description": "a standard func",
    "body": [
      "// ${1:name} takes ${2:params} and returns ${3:value}",
      "func $1($2) ($3) {",
      "\treturn $3{}",
      "}"
    ]
  },
  "mfn": {
    "prefix": "mfn",
    "description": "a method func",
    "body": [
      "// ${3:name} takes ${5:params} and returns ${6:value}",
      "func (${1:r} ${2:Recv}) $3($5) ($6) {",
      "\treturn $6{}",
      "}"
    ]
  },
  "tfn": {
    "prefix": "tfn",
    "description": "a standard test func (testify require)",
    "body": [
      "func Test${1:name}(t *testing.T) {",
      "\texp := ${3:expectation}",
      "\tact, err := $1(${2:params})",
      "\trequire.NoError(t, err)",
      "\trequire.Equal(t, exp, act)",
      "}"
    ]
  },
  "ttfn": {
    "prefix": "ttfn",
    "description": "table-driven test func for github.com/stretchr/testify/require",
    "body": [
      "func Test${2:subject}(t *testing.T) {",
      "\tfor _, tc := range []struct {",
      "\t\tname string",
      "\t\tin   $1",
      "\t\texp  []string",
      "\t}{",
      "\t\t{\"zero\", $1{}, []string{}},",
      "\t\t{\"one\", $1{}, []string{\"\"}},",
      "\t\t{\"two\", $1{}, []string{\"¿foo?\"}},",
      "\t\t{\"four\", $1{}, nil},",
      "\t\t{\"xmastree\", $1{}, []string{\"¿foo?\", \"¿bar?\", \"¿baz?\", \"¿gul?\", \"¿bit?\", \"¿lom?\", \"¿tir?\", \"¿lof?\"}},",
      "\t} {",
      "\t\tt.Run(tc.name, func(t *testing.T) {",
      "\t\t\tact := tc.in.$2()",
      "\t\t\trequire.Equal(t, tc.exp, act)",
      "\t\t})",
      "\t}",
      "}"
    ]
  },
  "pr": {
    "prefix": "pr",
    "description": "panic recover",
    "body": [
      "defer func() {",
      "\tswitch p := recover().(type) {",
      "\tcase nil, bailout:",
      "\t\t// normal return or early exit",
      "\tdefault:",
      "\t\t// re-panic",
      "\t\tpanic(p)",
      "\t}",
      "}()"
    ]
  }
}
