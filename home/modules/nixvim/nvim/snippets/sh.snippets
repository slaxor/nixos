snippet #! my standard shebang for bash
	#!/usr/bin/env bash
	# shellcheck shell=bash
	set -uo pipefail

	if [[ "\${BASH_SOURCE[0]}" == "\$0" ]]; then
		set -e

		${1:# your action}
	fi

snippet trap create an exit hook
	${1:cleanup}() {
		${2:echo "Cya in a while crocodile"}
	}
	trap ${1} INT QUIT TERM EXIT
