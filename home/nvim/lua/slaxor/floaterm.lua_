vim.g.floaterm_height = 24
vim.g.floaterm_winblend = 0
-- " hi Floaterm guibg=black
-- " Set floating window border line color to cyan, and background to
-- " orange
-- " hi FloatermBorder ctermfg=15 cterm=bold ctermbg=9 guibg=orange guifg=cyan

vim.api.nvim_create_user_command("Rg", function(opts)
  local c = string.format('FloatermNew --width=0.8 --height=0.8 rg %s', opts)
  vim.cmd(c)
end, { nargs = "+", complete = "command" })

