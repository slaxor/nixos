[alias]
	st = status
  di = diff --ignore-space-change --ignore-cr-at-eol
	ci = commit
	br = branch
	co = checkout
	sw = switch
	swm = switch master
	swc = switch -c
	df = diff
	lg = log -p
	oneline = log --pretty=oneline
	wh = log -n 40 --pretty=tformat:'%Cblue%h %Creset%cr by %Cred%cn %Cgreen%s%Creset'
	idid = log --author='Sascha Teske <sascha.teske@gmail.com>' --reverse --pretty=tformat:'%Cblue%h %Creset%ai %Cgreen%s%Creset'
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	lg = log --graph --format='%cd %C(yellow)%h%C(red bold)%d%Creset%C(cyan) [%cn]%Creset %s' --date=short --abbrev=10
	type = cat-file -t
	dump = cat-file -p
	pullall = "!f(){ git pull \"$@\" && git submodule update --init --recursive; }; f"
[fetch]
	recurseSubmodules = yes
[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[core]
	quotepath = false
  excludesfile = /home/slash/.gitignore_global
  editor = /usr/bin/nvim
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[diff]
	tool = meld
[merge]
	tool = meld
[push]
	default = current
[http]
	sslCAinfo = /etc/ssl/certs/ca-certificates.crt
	cookiefile = /home/slash/.gitcookies
[http "https://gopkg.in"]
	followRedirects = true
[credential]
	helper = !gopass show git-creds $@
[pull]
	rebase = false
[commit]
	gpgsign = true
[clean]
	requireForce = false
[init]
	defaultBranch = master
[rerere]
	enabled = true
[branch]
	sort = -committerdate
; [gpg]
;   format = ssh
[safe]
	directory = /opt/esp-idf
	directory = /opt/esp-idf
	directory = /opt/esp-idf/components/openthread/openthread
