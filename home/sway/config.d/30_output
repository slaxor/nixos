# swaymsg -t get_outputs
output * bg ~/.config/sway/pingu_oldschool_bg.jpg fit

output "eDP-2" {
	mode 2560x1600@165Hz
	pos 1270 2160
  scale 2.00
  adaptive_sync on
	transform normal
}
output "DP-5" {
	mode 3840x2160@59Hz
	pos 0 0
	transform normal
}
exec_always xrandr --output $(xrandr | grep -m 1 XWAYLAND | awk '{print $1;}') --primary
