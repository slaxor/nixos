{
    "#!": {
        "prefix": "#!",
        "body": "#!/usr/bin/env bash\n# shellcheck shell=bash\nset -euo pipefail",
        "description": "my standard shebang for bash"
    },
    "trap": {
        "prefix": "trap",
        "body": "${1:cleanup}() {\n ${2:echo \"Cya in a while crocodile\"}\n}\ntrap ${2} INT QUIT TERM EXIT\n",
				"description": "create an exit hook"
    }
}

