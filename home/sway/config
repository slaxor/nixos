set $cmd Mod4
set $alt Mod1
workspace_layout tabbed
# set $font "pango:Sofia 18"
set $font "pango:Iosevka Nerd Font Propo Medium 8"
font $font
set $term foot
# set $menu dmenu_path | dmenu | xargs swaymsg exec --
set $menu wofi --dmenu --allow-images --allow-markup --insensitive
exec swayidle -w \
         timeout 300 'swaylock -f -c 446161' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 446161'
exec ydotoold --socket-path=/run/user/10000/ydotool.sock
# swaymsg -t get_inputs
include ${HOME}/.config/sway/config.d/*
